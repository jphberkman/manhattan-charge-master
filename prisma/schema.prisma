// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projects  Project[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  messages  String   @default("[]")
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hospital {
  id            String    @id @default(cuid())
  name          String
  address       String
  borough       String    @default("Manhattan")
  sourceFile    String
  lastSeeded    DateTime?
  cmsProviderId String?   // CMS CCN (6-digit), e.g. "330214" for NYU
  npi           String?   // National Provider Identifier
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prices     PriceEntry[]

  @@index([name])
}

model Procedure {
  id          String   @id @default(cuid())
  cptCode     String   @unique
  name        String
  category    String
  description String   @default("")

  prices      PriceEntry[]

  @@index([name])
  @@index([category])
}

model PriceEntry {
  id           String   @id @default(cuid())
  hospitalId   String
  procedureId  String?
  payerName    String
  payerType    String
  priceInCents Int
  priceType    String
  rawCode      String   @default("")
  source       String   @default("mrf")  // "mrf" | "cms" | "upload" | "dolthub" | "mrf-v2"
  createdAt    DateTime @default(now())

  // ── Provenance + full-fidelity fields (2026-09 re-ingest; null on legacy rows) ──
  sourceFileId String?
  asOf         DateTime?
  /** Primary billing code from the file (CPT/HCPCS/DRG/CDM/…). */
  code         String?
  /** cpt-shaped | hcpcs-level-2 | ms-drg | apr-drg | cdm | rc | ndc | local | unknown */
  codeKind     String?
  /** Hospital's own service description (consumer display text). */
  description  String?
  planName     String?
  methodology  String?
  billingClass String?
  setting      String?
  /** De-identified min/max and median for this item, when the file publishes them. */
  minCents     Int?
  maxCents     Int?
  medianCents  Int?

  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  procedure    Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
  @@index([procedureId, payerType])
  @@index([procedureId, payerType, priceType])
  @@index([hospitalId])
  @@index([hospitalId, procedureId])
  @@index([payerType, priceType])
  @@index([procedureId, priceType, priceInCents])
  @@index([hospitalId, payerType, priceType])
  @@index([hospitalId, code])
}

/// Distinct (hospital, code, description) from fresh per-campus ingest.
/// Search surface for full-text over hospital service descriptions.
model ServiceDescription {
  id           String  @id @default(cuid())
  hospitalId   String
  code         String
  codeKind     String
  description  String
  sourceFileId String?

  @@unique([hospitalId, code, description])
  @@index([hospitalId])
  @@index([code])
}

/// Precomputed aggregates per (hospital, code, payer class, price type).
/// Consumer reads hit this table, never 45M PriceEntry rows.
model PriceSummary {
  id          String    @id @default(cuid())
  hospitalId  String
  code        String
  codeKind    String
  payerClass  String    // gross | cash | commercial | medicare | medicaid | other
  priceType   String    // gross | cash | negotiated
  minCents    Int
  medianCents Int
  maxCents    Int
  count       Int
  latestAsOf  DateTime?

  @@unique([hospitalId, code, payerClass, priceType])
  @@index([code])
  @@index([hospitalId])
}

/// Skinny search index: one row per (hospital, billing code).
/// Built from Neon warehouse MRFs (`shopforcare-price-transparency`).
/// The app queries this table — never raw chargemaster objects.
model PriceIndex {
  id                 String    @id @default(cuid())
  hospitalId         String
  code               String
  codeKind           String
  description        String?
  /** Gross / chargemaster list price (median of published gross amounts). */
  listCents          Int?
  /** Discounted cash / self-pay (median). */
  cashCents          Int?
  /** Median payer-negotiated dollar amount (all commercial/gov payers with a $). */
  negotiatedCents    Int?
  negotiatedMinCents Int?
  negotiatedMaxCents Int?
  sampleCount        Int       @default(0)
  /** Warehouse object key; originals stay in Neon storage. */
  objectKey          String
  asOf               DateTime?
  ingestedAt         DateTime  @default(now())

  @@unique([hospitalId, code])
  @@index([code])
  @@index([hospitalId])
}

model CptCode {
  code        String   @id          // e.g. "27447"
  description String                // e.g. "Total knee replacement"
  category    String   @default("") // optional grouping
  /** CMS Medicare allowed amount (national avg, in USD). RVU-based benchmark. */
  medicareRate  Float?
  /** Average submitted charge (national avg, in USD). Chargemaster benchmark. */
  avgCharge     Float?
  /** Total Medicare services rendered nationally. Proxy for procedure frequency. */
  totalServices   Float?
  /** Manhattan locality facility allowed amount (USD). */
  facilityRate    Float?
  /** Manhattan locality non-facility allowed amount (USD). */
  nonFacilityRate Float?
  /** Total RVU for reference. */
  totalRvu        Float?
  createdAt   DateTime @default(now())

  @@index([description])
}

/// Maps common patient conditions/symptoms to the most appropriate CPT procedures.
/// Enables symptom-based search: "gallstones" → CPT 47562 (lap cholecystectomy).
model ConditionMapping {
  id          String   @id @default(cuid())
  /** Natural language condition or symptom (e.g. "gallstones", "torn ACL"). */
  condition   String
  /** ICD-10-CM code if applicable (e.g. "K80.2", "S83.51"). */
  icd10Code   String   @default("")
  /** Target CPT code for the most common treatment. */
  cptCode     String
  /** Procedure name for display. */
  procedureName String
  /** Relevance weight (higher = more common treatment for this condition). */
  weight      Int      @default(100)

  @@unique([condition, cptCode])
  @@index([condition])
  @@index([icd10Code])
  @@index([cptCode])
}

model SearchLog {
  id            String   @id @default(cuid())
  query         String
  endpoint      String
  resultCount   Int      @default(0)
  cptCode       String?
  procedureName String?
  insurerName   String?
  payerType     String?
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

/// CMS inpatient/outpatient charge data (from CMS Provider Utilization & Payment Data).
/// Aggregates average charges, total payments, and Medicare payments per DRG per provider.
model CmsChargeData {
  id                  String   @id @default(cuid())
  providerId          String   // CMS CCN
  hospitalName        String
  drgCode             String   // MS-DRG or APC code
  drgDescription      String
  totalDischarges     Int
  avgCoveredCharges   Int      // cents
  avgTotalPayments    Int      // cents
  avgMedicarePayments Int      // cents
  dataYear            Int
  serviceType         String   // "inpatient" | "outpatient"
  createdAt           DateTime @default(now())

  @@unique([providerId, drgCode, dataYear, serviceType])
  @@index([drgCode])
  @@index([providerId])
}

/// Inline-editable site content (key/value text storage for CMS-like editing).
model SiteContent {
  key       String   @id          // e.g. "home.hero.headline"
  value     String               // the actual text content
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")  // who edited it
}

/// Tracks every content edit for audit trail and revert capability.
model ContentHistory {
  id         String   @id @default(cuid())
  key        String                // which content key was changed
  oldValue   String               // previous value
  newValue   String               // new value
  changedAt  DateTime @default(now())
  changedBy  String   @default("admin")

  @@index([key])
  @@index([changedAt])
}

/// Inventory of hospital machine-readable files. Additive; does not replace PriceEntry.
model SourceFile {
  id             String    @id @default(cuid())
  filename       String
  sha256         String?
  bytes          Int?
  hospitalKey    String?
  sourceUrl      String?
  format         String?
  parser         String?
  /** Identity read from the file header — never from the filename. */
  headerName     String?
  headerLocation String?
  headerNpi      String?
  /** File's own as_of / last_updated_on date. */
  asOf           DateTime?
  status         String    @default("discovered")
  rowsDiscovered Int       @default(0)
  rowsParsed     Int       @default(0)
  rowsRejected   Int       @default(0)
  rowsInserted   Int       @default(0)
  warningCount   Int       @default(0)
  errorMessage   String?
  ingestedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([filename])
}

/// NUBC Revenue Codes — maps 4-digit facility charge categories to CPT procedures.
/// Hospitals often list facility fees by revenue code (e.g. 0360 = Operating Room)
/// rather than CPT code. This table links them for price aggregation.
model RevenueCode {
  code        String   @id          // e.g. "0360"
  description String                // e.g. "Operating Room Services"
  category    String   @default("") // e.g. "Facility", "Ancillary", "Accommodation"
  /** Related CPT code category (maps rev code to what type of charge it represents). */
  chargeType  String   @default("") // "facility" | "supply" | "pharmacy" | "room" | "diagnostic" | "therapy" | "other"
}
